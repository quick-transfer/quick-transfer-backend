DATABASE_URL=jdbc:postgresql://localhost:5432/quick_transfer
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-a-strong-password
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

PUBLIC_KEY=replace-with-rsa-public-key
PRIVATE_KEY=replace-with-rsa-private-key-pkcs8
JWT_ISSUER=quick-transfer

MAIL_USERNAME=replace-with-smtp-user
MAIL_PASSWORD=replace-with-smtp-app-password
MAIL_FROM=no-reply@quick-transfer.local
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
FRONTEND_URL=http://localhost:3000

COOKIE_SECURE=false
JPA_DDL_AUTO=validate
LOCAL_CACHE_ENABLED=false
